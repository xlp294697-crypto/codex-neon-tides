server {
    listen 80;
    listen [::]:80;
    server_name sports.example.com;
    return 301 https://$host$request_uri;
}

server {
    # 兼容仍在使用旧语法的发行版 Nginx；1.25.1+ 可改为 listen 443 ssl; 与 http2 on;。
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sports.example.com;

    ssl_certificate /etc/letsencrypt/live/sports.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sports.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;

    client_max_body_size 64k;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}

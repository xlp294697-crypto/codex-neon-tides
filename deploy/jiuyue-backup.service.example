[Unit]
Description=Backup Jiuyue Sports website data

[Service]
Type=oneshot
User=jiuyue
Group=jiuyue
WorkingDirectory=/opt/jiuyue-sports
Environment=BACKUP_RETENTION_DAYS=90
ExecStart=/bin/sh /opt/jiuyue-sports/tools/backup-data.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/opt/jiuyue-sports/data
ReadWritePaths=/opt/jiuyue-sports/backups
